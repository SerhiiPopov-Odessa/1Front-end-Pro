generator client {
    provider = "prisma-client-js"
    //output   = "/app/generated/prisma-client"
}

datasource db {
    provider  = "postgresql" // Я работаю с PostgreSQL
    url       = env("PRISMA_DATABASE_URL") // — это основное подключение Prisma Client к базе данных, работает через connection pool.
    directUrl = env("POSTGRES_URL") // — отдельное прямое подключение, которое Prisma использует для миграций и операций, 
    //где connection pool может мешать поэтому разделяют. По directUrl создаёт таблицы;изменяет структуру базы;
    //обновляет _prisma_migrations. А обычные запросы используют url.
}

model User {
    id Int @id @default(autoincrement())

    fullName String
    email    String   @unique
    password String
    role     UserRole @default(USER)
    verified DateTime?

    provider   String? // через какую социальную сеть юзер зашёл
    providerId String?

    cart             Cart? // это не колонка в таблице, это связь с таблицей Cart один к одному
    orders           Order[]
    verificationCode VerificationCode?// это не колонка в таблице, это связь с таблицей VerificationCode один к одному

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum UserRole {
    USER
    ADMIN
}

model Category {
    id        Int       @id @default(autoincrement())
    name      String    @unique
    products  Product[] // категория может содержать много разновидностей продуктов. категория пицы может содержать разные виды пиц
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model Product {
    id Int @id @default(autoincrement())

    name     String
    imageUrl String

    ingredients Ingredient[] // Ингредиенты

    items       ProductItem[] // Вариации продукта

    category   Category @relation(fields: [categoryId], references: [id])// продукт содержит только одну категорию. пица относится 
                                                                         //только к категории пицы
    categoryId Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ProductItem { // Вариации продукта, размеры
    id Int @id @default(autoincrement())

    price     Int
    size      Int?
    pizzaType Int?

    cartItems CartItem[]

    product   Product @relation(fields: [productId], references: [id])
    productId Int
}

model Ingredient {
    id       Int    @id @default(autoincrement())
    name     String
    price    Int
    imageUrl String

    products Product[]

    cartItems CartItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Cart { // карзина
    id Int @id @default(autoincrement())

    user   User? @relation(fields: [userId], references: [id]) //  fields: [userId] говорит: В текущей таблице (Cart) 
    userId Int?  @unique                                       //внешний ключ хранится в поле userId.
                                                               //references: [id]
                                                               //говорит:Этот внешний ключ ссылается на User.id.
                                                               //То есть Cart.userId = User.id
    items CartItem[]

    token       String // для добовления в карзину без регистрации

    totalAmount Int      @default(0) // общая сумма карзины

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model CartItem {
    id            Int          @id @default(autoincrement())
    cart          Cart         @relation(fields: [cartId], references: [id])
    cartId        Int
    productItem   ProductItem  @relation(fields: [productItemId], references: [id])
    productItemId Int
    quantity      Int          @default(1)// количество продукта
    //quantity      Int         // количество продукта
    ingredients   Ingredient[] // доп ингредиенты попимо вариаций
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt
}

model Order {
    id          Int         @id @default(autoincrement())
    user        User?       @relation(fields: [userId], references: [id])
    userId      Int?
    token       String

    totalAmount Int
    status      OrderStatus
    paymentId   String? // id для сервиса оплаты
    items       Json // список товаров в json формате. Prisma позволяет хранить в Json любые валидные JSON-значения.
                     //Можно хранить:
                     //items: { a: 1 }      // объект
                     //items: [1, 2, 3]     // массив
                     //items: 'text'        // строку
                     //items: 123           // число
                     //items: true          // boolean
                     //items: null

    fullName String // получатель заказа и его инфо
    email    String
    phone    String
    address  String
    comment  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum OrderStatus {
    PENDING
    SUCCEEDED
    CANCELLED
}

model VerificationCode {
    id        Int      @id @default(autoincrement())
    user      User     @relation(fields: [userId], references: [id])
    userId    Int      @unique
    code      String
    createdAt DateTime @default(now())

    @@unique([userId, code]) // груповая проверка уникальности не может быть одинакового кода у юзера
}

